rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Role Helper Functions (Claims-Only Trusted Authorization)
    // =========================================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Trusted Authorization via Firebase Auth Custom Claims
    function hasRole(roleName) {
      return isAuthenticated() && (
        request.auth.token.role == roleName ||
        (!('role' in request.auth.token) && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == roleName)
      );
    }

    function isAdmin() {
      return hasRole('admin');
    }

    function isDoctor() {
      return hasRole('doctor');
    }

    function isPharmacist() {
      return hasRole('pharmacist');
    }

    function isBloodBank() {
      return hasRole('blood_bank');
    }

    function isAssignedDoctor(patientId) {
      return isDoctor() && 
        exists(/databases/$(database)/documents/patients/$(patientId)) &&
        get(/databases/$(database)/documents/patients/$(patientId)).data.doctorId == request.auth.uid;
    }

    function isPatientOwner(patientId) {
      return isOwner(patientId) || 
        (isAuthenticated() && exists(/databases/$(database)/documents/patients/$(patientId)) &&
         get(/databases/$(database)/documents/patients/$(patientId)).data.userId == request.auth.uid);
    }

    // =========================================================================
    // Menstrual Health Specific Security Helpers (Strict Patient Owner)
    // =========================================================================
    function isStrictPatientOwner(userId) {
      return isAuthenticated()
        && request.auth.uid == userId
        // Deny all privileged staff roles even on their own UID paths
        && !('role' in request.auth.token && request.auth.token.role in ['admin', 'doctor', 'pharmacist', 'blood_bank'])
        // Deny any unknown/unauthorized role claims; only allow explicit 'patient' or standard claimless patient signups
        && (!('role' in request.auth.token) || request.auth.token.role == 'patient');
    }

    function isISODateString(val) {
      return val is string && val.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function areValidSymptoms(list) {
      return list.hasOnly([
        'cramps',
        'headache',
        'bloating',
        'acne',
        'breast_tenderness',
        'back_pain',
        'fatigue',
        'nausea',
        'other'
      ]);
    }

    // =========================================================================
    // 1. Users Directory: Private Profile Isolation (Owner & Admin Only)
    // =========================================================================
    match /users/{userId} {
      // User profiles are strictly private: owner and admin only.
      // Assigned doctors can view their assigned patient's core user document if linked.
      allow read: if isOwner(userId) || 
        isAdmin() || 
        (isDoctor() && resource.data.doctorId == request.auth.uid);

      // On signup, clients can create role in ['patient', 'doctor', 'pharmacist', 'blood_bank'].
      allow create: if isOwner(userId) && 
        (!('role' in request.resource.data) || request.resource.data.role in ['patient', 'doctor', 'pharmacist', 'blood_bank'] || isAdmin());

      // On profile update, 'role' is strictly IMMUTABLE from the client to prevent role escalation.
      allow update: if (isOwner(userId) && (!('role' in request.resource.data.diff(resource.data).affectedKeys()) || isAdmin())) ||
        (isDoctor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctorId']));

      allow delete: if isAdmin();

      // -----------------------------------------------------------------------
      // 1.1 Menstrual Records Subcollection (Strict Patient Isolation)
      // -----------------------------------------------------------------------
      match /menstrualRecords/{recordId} {
        allow read, delete: if isStrictPatientOwner(userId);

        allow create: if isStrictPatientOwner(userId)
          && recordId == ('period_' + request.resource.data.startDate)
          && request.resource.data.keys().hasAll(['startDate', 'flow', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['startDate', 'endDate', 'flow', 'source', 'notes', 'createdAt', 'updatedAt'])
          && isISODateString(request.resource.data.startDate)
          && (!('endDate' in request.resource.data) || request.resource.data.endDate == null || (isISODateString(request.resource.data.endDate) && request.resource.data.endDate >= request.resource.data.startDate))
          && request.resource.data.flow in ['light', 'medium', 'heavy']
          && request.resource.data.source == 'user'
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isStrictPatientOwner(userId)
          && request.resource.data.keys().hasAll(['startDate', 'flow', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['startDate', 'endDate', 'flow', 'source', 'notes', 'createdAt', 'updatedAt'])
          && request.resource.data.startDate == resource.data.startDate
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.source == resource.data.source
          && (!('endDate' in request.resource.data) || request.resource.data.endDate == null || (isISODateString(request.resource.data.endDate) && request.resource.data.endDate >= request.resource.data.startDate))
          && request.resource.data.flow in ['light', 'medium', 'heavy']
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 1000))
          && request.resource.data.updatedAt == request.time;
      }

      // -----------------------------------------------------------------------
      // 1.2 Menstrual Daily Logs Subcollection (Strict Patient Isolation)
      // -----------------------------------------------------------------------
      match /menstrualLogs/{logId} {
        allow read, delete: if isStrictPatientOwner(userId);

        allow create: if isStrictPatientOwner(userId)
          && logId == ('log_' + request.resource.data.date)
          && request.resource.data.keys().hasAll(['date', 'flow', 'symptoms', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['date', 'flow', 'symptoms', 'mood', 'energy', 'sleepHours', 'sleepQuality', 'notes', 'source', 'createdAt', 'updatedAt'])
          && isISODateString(request.resource.data.date)
          && request.resource.data.flow in ['none', 'spotting', 'light', 'medium', 'heavy']
          && request.resource.data.symptoms is list && request.resource.data.symptoms.size() <= 9 && areValidSymptoms(request.resource.data.symptoms)
          && request.resource.data.source == 'user'
          && (!('mood' in request.resource.data) || request.resource.data.mood == null || request.resource.data.mood in ['happy', 'calm', 'anxious', 'irritable', 'sad'])
          && (!('energy' in request.resource.data) || request.resource.data.energy == null || (request.resource.data.energy is int && request.resource.data.energy >= 1 && request.resource.data.energy <= 5))
          && (!('sleepHours' in request.resource.data) || request.resource.data.sleepHours == null || ((request.resource.data.sleepHours is int || request.resource.data.sleepHours is float) && request.resource.data.sleepHours >= 0 && request.resource.data.sleepHours <= 24))
          && (!('sleepQuality' in request.resource.data) || request.resource.data.sleepQuality == null || request.resource.data.sleepQuality in ['restful', 'disrupted', 'insomnia'])
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
          && request.resource.data.createdAt == request.time
          && request.resource.data.updatedAt == request.time;

        allow update: if isStrictPatientOwner(userId)
          && request.resource.data.keys().hasAll(['date', 'flow', 'symptoms', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.keys().hasOnly(['date', 'flow', 'symptoms', 'mood', 'energy', 'sleepHours', 'sleepQuality', 'notes', 'source', 'createdAt', 'updatedAt'])
          && request.resource.data.date == resource.data.date
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.source == resource.data.source
          && request.resource.data.flow in ['none', 'spotting', 'light', 'medium', 'heavy']
          && request.resource.data.symptoms is list && request.resource.data.symptoms.size() <= 9 && areValidSymptoms(request.resource.data.symptoms)
          && (!('mood' in request.resource.data) || request.resource.data.mood == null || request.resource.data.mood in ['happy', 'calm', 'anxious', 'irritable', 'sad'])
          && (!('energy' in request.resource.data) || request.resource.data.energy == null || (request.resource.data.energy is int && request.resource.data.energy >= 1 && request.resource.data.energy <= 5))
          && (!('sleepHours' in request.resource.data) || request.resource.data.sleepHours == null || ((request.resource.data.sleepHours is int || request.resource.data.sleepHours is float) && request.resource.data.sleepHours >= 0 && request.resource.data.sleepHours <= 24))
          && (!('sleepQuality' in request.resource.data) || request.resource.data.sleepQuality == null || request.resource.data.sleepQuality in ['restful', 'disrupted', 'insomnia'])
          && (!('notes' in request.resource.data) || (request.resource.data.notes is string && request.resource.data.notes.size() <= 2000))
          && request.resource.data.updatedAt == request.time;
      }
    }

    // =========================================================================
    // 2. Public Doctor Lookup Directory (Minimal Non-Sensitive Projection)
    // =========================================================================
    match /publicDoctorProfiles/{doctorId} {
      // Authenticated users can view public doctor profiles for appointment scheduling
      allow read: if isAuthenticated();

      // Only the verified doctor owner or admin can create or modify public doctor profiles
      // Strictly enforce approved non-sensitive fields
      allow create, update: if ((isOwner(doctorId) &&
        request.resource.data.keys().hasOnly(['name', 'specialization', 'profileImage', 'availability', 'doctorId']) &&
        (!('doctorId' in request.resource.data) || request.resource.data.doctorId == request.auth.uid)) || isAdmin());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 3. Pharmacy Patient Lookup Directory (Minimal Non-Sensitive Projection)
    // =========================================================================
    match /pharmacyPatientLookup/{patientId} {
      // Only authorized pharmacists and administrators can read the billing lookup directory
      allow read: if isPharmacist() || isAdmin();

      // Patients can only create or update their own lookup record with strictly permitted minimal fields
      allow create: if ((isOwner(patientId) && 
        request.resource.data.keys().hasOnly(['displayName', 'patientReference', 'createdAt']) &&
        request.resource.data.patientReference == request.auth.uid) || isAdmin());

      allow update: if ((isOwner(patientId) && 
        request.resource.data.keys().hasOnly(['displayName', 'patientReference', 'createdAt']) &&
        request.resource.data.patientReference == resource.data.patientReference &&
        request.resource.data.patientReference == request.auth.uid) || isAdmin());

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 4. Patients & Medical History: Doctor Assignment & Clinical Immutability
    // =========================================================================
    match /patients/{patientId} {
      // Patient owner, assigned doctor, and admin can read the patient profile.
      // Pharmacists are strictly FORBIDDEN from browsing patient profiles.
      allow read: if isPatientOwner(patientId) || 
        isAssignedDoctor(patientId) || 
        isAdmin();

      // On creation, patient can only create their own profile bound to auth.uid
      allow create: if isAuthenticated() && 
        (request.resource.data.userId == request.auth.uid || isOwner(patientId) || isAdmin());

      // On update, patient cannot change userId or doctorId; assigned doctor can link doctorId
      allow update: if (isPatientOwner(patientId) && 
          request.resource.data.userId == resource.data.userId &&
          (!('doctorId' in request.resource.data) || request.resource.data.doctorId == resource.data.doctorId)) ||
        (isDoctor() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['doctorId'])) ||
        isAdmin();

      allow delete: if isAdmin();

      // Clinical Medical Records: Patient can read; ONLY assigned doctor can append; history is immutable
      match /medicalRecords/{recordId} {
        allow read: if isPatientOwner(patientId) || isAssignedDoctor(patientId) || isAdmin();
        allow create: if isAssignedDoctor(patientId) && request.resource.data.doctorId == request.auth.uid;
        allow update, delete: if isAdmin();
      }

      // Patient Bills subcollection
      match /bills/{billId} {
        allow read: if isPatientOwner(patientId) || 
          (isPharmacist() && resource.data.pharmacistId == request.auth.uid) || 
          isAdmin();
        allow create: if isPharmacist() && request.resource.data.pharmacistId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    // =========================================================================
    // 5. Central Invoices / Bills: Scoped to Patient & Issuing Pharmacist
    // =========================================================================
    match /bills/{billId} {
      allow read: if isAuthenticated() && 
        (resource.data.patientId == request.auth.uid || 
         resource.data.pharmacistId == request.auth.uid || 
         isAdmin());

      allow create: if isPharmacist() && request.resource.data.pharmacistId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // =========================================================================
    // 6. Appointments: Explicit Scoping (Patients & Assigned Doctors Only)
    // =========================================================================
    match /appointments/{appointmentId} {
      // Individual appointment read: patient owner, assigned doctor, or admin
      allow get: if isAuthenticated() && 
        (resource.data.patientId == request.auth.uid || 
         (isDoctor() && resource.data.doctorId == request.auth.uid) || 
         isAdmin());

      // List queries: must be filtered by patientId == auth.uid (patient) or doctorId == auth.uid (doctor)
      allow list: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid) ||
        (isDoctor() && resource.data.doctorId == request.auth.uid) ||
        isAdmin()
      );

      // Patients can create appointments for themselves in 'pending' status
      allow create: if isAuthenticated() && 
        request.resource.data.patientId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        (!('recordAdded' in request.resource.data) || request.resource.data.recordAdded == false);

      // Updates are field-restricted:
      // - Patient can only update notes or cancel (cannot change doctor, time, patientId, or complete)
      // - Assigned doctor can update status ('scheduled', 'completed', 'cancelled') and recordAdded
      allow update: if isAuthenticated() && (
        (resource.data.patientId == request.auth.uid && 
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.doctorId == resource.data.doctorId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         (request.resource.data.status == resource.data.status || request.resource.data.status == 'cancelled')) ||
        (isDoctor() && resource.data.doctorId == request.auth.uid && 
         request.resource.data.patientId == resource.data.patientId &&
         request.resource.data.doctorId == resource.data.doctorId &&
         request.resource.data.date == resource.data.date &&
         request.resource.data.time == resource.data.time &&
         (request.resource.data.status in ['scheduled', 'completed', 'cancelled'])) ||
        isAdmin()
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 7. Pharmacy Inventory: Strictly Isolated to Owning Pharmacist
    // =========================================================================
    match /inventory/{userId}/medicines/{medicineId} {
      allow read, write: if isOwner(userId) && isPharmacist();
    }
  
// =============================================================================
// MEDICORE-AI — Phase 4A.1 Hardened Firestore Security Rules Fragment
// FILE: docs/phase-4/blood-bank-firestore-rules.fragment
//
// NOTICE: THIS FILE IS A DRAFT PROPOSAL FOR FUTURE INTEGRATION.
// IT IS NOT A DEPLOYABLE REPLACEMENT OF PRODUCTION firestore.rules.
// DO NOT OVERWRITE THE PRODUCTION firestore.rules FILE WITH THIS FRAGMENT.
//
// INTEGRATION INSTRUCTIONS:
// In a future integration sprint (Phase 4B/4C), this block should be spliced
// inside the `service cloud.firestore { match /databases/{database}/documents { ... } }`
// block of the root `firestore.rules`.
//
// PREREQUISITES IN ROOT RULES:
// 1. `isAuthenticated()` helper: request.auth != null
// 2. `hasRole(roleName)` helper: isAuthenticated() && request.auth.token.role == roleName
// 3. `isBloodBank()` helper: hasRole('blood_bank')
// =============================================================================

    // Helper function for patient role (Phase 4B)
    function isPatient() {
      return hasRole('patient');
    }

    // =========================================================================
    // 8. Isolated Blood Bank Subsystem (Namespace: bloodBank/{centerId}/...)
    // =========================================================================
    match /bloodBank/{centerId} {
      // Helper function to enforce legal inventory state transition matrix in rules
      function isValidInventoryStateTransition(fromStatus, toStatus) {
        return fromStatus == toStatus ||
          (fromStatus == 'quarantine' && toStatus in ['available', 'discarded', 'expired']) ||
          (fromStatus == 'available' && toStatus in ['reserved', 'quarantine', 'expired', 'discarded']) ||
          (fromStatus == 'reserved' && toStatus in ['transfused', 'available', 'quarantine', 'expired', 'discarded']) ||
          (fromStatus == 'expired' && toStatus in ['discarded']);
      }

      // Helper function to enforce legal request state transition matrix in rules
      function isValidRequestStateTransition(fromStatus, toStatus) {
        return fromStatus == toStatus ||
          (fromStatus == 'submitted' && toStatus in ['under_review', 'approved', 'rejected', 'cancelled']) ||
          (fromStatus == 'under_review' && toStatus in ['approved', 'rejected', 'cancelled']) ||
          (fromStatus == 'approved' && toStatus in ['partially_fulfilled', 'fulfilled', 'cancelled']) ||
          (fromStatus == 'partially_fulfilled' && toStatus in ['fulfilled', 'cancelled']);
      }

      // Helper function to enforce legal distribution/issue state transition matrix in rules
      function isValidIssueStateTransition(fromStatus, toStatus) {
        return fromStatus == toStatus ||
          (fromStatus in ['prepared', 'dispatched'] && toStatus in ['dispatched', 'in_transit', 'delivered', 'cancelled']) ||
          (fromStatus == 'in_transit' && toStatus in ['delivered', 'cancelled']);
      }

      // Helper function to verify that all inventory units in a list (bounded up to 4 units) are transfused
      function areUnitsTransfused(centerId, unitList) {
        return unitList.size() == 0 || (
          unitList.size() == 1 ? (getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status == 'transfused') :
          unitList.size() == 2 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status == 'transfused'
          ) :
          unitList.size() == 3 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status == 'transfused'
          ) :
          unitList.size() == 4 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status == 'transfused' &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[3])).data.status == 'transfused'
          ) :
          false // Unbounded lists cannot be verified within Firestore Rules limits; require trusted server boundary
        );
      }

      // Helper function to verify that all inventory units in a list (bounded up to 4 units) are transfused specifically for requestId
      function isUnitTransfusedForRequest(centerId, unitId, requestId) {
        let inv = getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitId)).data;
        return inv.status == 'transfused' && inv.reservedForRequestId == requestId && inv.centerId == centerId;
      }

      function areUnitsTransfusedForRequest(centerId, unitList, requestId) {
        return unitList.size() == 0 || (
          unitList.size() == 1 ? isUnitTransfusedForRequest(centerId, unitList[0], requestId) :
          unitList.size() == 2 ? (
            isUnitTransfusedForRequest(centerId, unitList[0], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[1], requestId)
          ) :
          unitList.size() == 3 ? (
            isUnitTransfusedForRequest(centerId, unitList[0], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[1], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[2], requestId)
          ) :
          unitList.size() == 4 ? (
            isUnitTransfusedForRequest(centerId, unitList[0], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[1], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[2], requestId) &&
            isUnitTransfusedForRequest(centerId, unitList[3], requestId)
          ) :
          false
        );
      }

      // Helper function to verify that all inventory units in a list (bounded up to 4 units) are reserved specifically for requestId
      function isUnitReservedForRequest(centerId, unitId, requestId) {
        let inv = getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitId)).data;
        return inv.status == 'reserved' && inv.reservedForRequestId == requestId && inv.centerId == centerId;
      }

      function areUnitsReservedForRequest(centerId, unitList, requestId) {
        return unitList.size() == 0 || (
          unitList.size() == 1 ? isUnitReservedForRequest(centerId, unitList[0], requestId) :
          unitList.size() == 2 ? (
            isUnitReservedForRequest(centerId, unitList[0], requestId) &&
            isUnitReservedForRequest(centerId, unitList[1], requestId)
          ) :
          unitList.size() == 3 ? (
            isUnitReservedForRequest(centerId, unitList[0], requestId) &&
            isUnitReservedForRequest(centerId, unitList[1], requestId) &&
            isUnitReservedForRequest(centerId, unitList[2], requestId)
          ) :
          unitList.size() == 4 ? (
            isUnitReservedForRequest(centerId, unitList[0], requestId) &&
            isUnitReservedForRequest(centerId, unitList[1], requestId) &&
            isUnitReservedForRequest(centerId, unitList[2], requestId) &&
            isUnitReservedForRequest(centerId, unitList[3], requestId)
          ) :
          false
        );
      }

      // Helper function to verify that all allocated units being removed are either delivered (transfused) or released (available)
      function areAllocatedUnitsReleasedOrTransfused(centerId, unitList) {
        return unitList.size() == 0 || (
          unitList.size() == 1 ? (getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'transfused']) :
          unitList.size() == 2 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'transfused']
          ) :
          unitList.size() == 3 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status in ['available', 'transfused']
          ) :
          unitList.size() == 4 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status in ['available', 'transfused'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[3])).data.status in ['available', 'transfused']
          ) :
          false // Unbounded lists cannot be verified within Firestore Rules limits; require trusted server boundary
        );
      }

      // Helper function to verify that all inventory units in a list (bounded up to 4 units) are available or disposed
      function areUnitsAvailableOrDisposed(centerId, unitList) {
        return unitList.size() == 0 || (
          unitList.size() == 1 ? (getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'quarantine', 'discarded', 'expired']) :
          unitList.size() == 2 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'quarantine', 'discarded', 'expired']
          ) :
          unitList.size() == 3 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status in ['available', 'quarantine', 'discarded', 'expired']
          ) :
          unitList.size() == 4 ? (
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[0])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[1])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[2])).data.status in ['available', 'quarantine', 'discarded', 'expired'] &&
            getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/inventory/$(unitList[3])).data.status in ['available', 'quarantine', 'discarded', 'expired']
          ) :
          false // Unbounded lists cannot be verified within Firestore Rules limits; require trusted server boundary
        );
      }

      // Helper function to verify that inventory creation references a valid tested donation session
      function isValidInventoryDonation(centerId, donationId, donorId, bloodGroup) {
        let don = get(/databases/$(database)/documents/bloodBank/$(centerId)/donations/$(donationId)).data;
        return don.centerId == centerId
          && don.screeningStatus == 'tested_passed'
          && don.donorId == donorId
          && don.bloodGroup == bloodGroup;
      }

      // Phase 4B: Center directory metadata and availableStockSummary readable by all authenticated clinical/patient roles
      allow read: if isAuthenticated();
      // Center metadata update allowed only for authenticated blood bank staff updating availableStockSummary
      allow update: if isAuthenticated() && isBloodBank()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['availableStockSummary', 'updatedAt'])
        && request.resource.data.id == resource.data.id
        && (!('availableStockSummary' in request.resource.data) || request.resource.data.availableStockSummary is map);
      allow create: if isAuthenticated() && (isAdmin() || (isBloodBank() && request.resource.data.isExhibitionCenter == true));
      allow delete: if false;

      // -----------------------------------------------------------------------
      // 8.1 Donors Registry
      // Confidential donor identity, contact, eligibility, and screening status.
      // Data minimization: uses donorReferenceId; nationalIdOrPassport is optional.
      // -----------------------------------------------------------------------
      match /donors/{donorId} {
        allow read: if isAuthenticated() && isBloodBank();
        
        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == donorId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'donorReferenceId', 'fullName', 'dateOfBirth',
            'gender', 'bloodGroup', 'contact', 'eligibilityStatus', 'donationCount',
            'verifiedByStaffUid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donorReferenceId', 'fullName', 'nationalIdOrPassport',
            'dateOfBirth', 'gender', 'bloodGroup', 'contact', 'eligibilityStatus',
            'deferralReason', 'deferralUntil', 'lastDonationDate', 'donationCount',
            'weightKg',
            'verifiedByStaffUid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.donorReferenceId is string
          && request.resource.data.donorReferenceId.size() >= 3
          && request.resource.data.fullName is string
          && request.resource.data.fullName.size() >= 2
          && request.resource.data.contact is map
          && request.resource.data.donationCount is int
          && request.resource.data.donationCount == 0
          && request.resource.data.gender in ['male', 'female', 'other']
          && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
          && request.resource.data.eligibilityStatus in ['eligible', 'temporarily_deferred', 'permanently_deferred', 'pending_screening']
          && request.resource.data.verifiedByStaffUid == request.auth.uid
          && (!('weightKg' in request.resource.data) || (request.resource.data.weightKg is number && request.resource.data.weightKg >= 30 && request.resource.data.weightKg <= 250));

        allow update: if isAuthenticated() && isBloodBank()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fullName', 'nationalIdOrPassport', 'contact', 'eligibilityStatus',
            'deferralReason', 'deferralUntil', 'lastDonationDate', 'donationCount',
            'weightKg',
            'verifiedByStaffUid', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.centerId == resource.data.centerId
          && request.resource.data.donorReferenceId == resource.data.donorReferenceId
          && request.resource.data.dateOfBirth == resource.data.dateOfBirth
          && request.resource.data.gender == resource.data.gender
          && request.resource.data.bloodGroup == resource.data.bloodGroup
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donorReferenceId', 'fullName', 'nationalIdOrPassport',
            'dateOfBirth', 'gender', 'bloodGroup', 'contact', 'eligibilityStatus',
            'deferralReason', 'deferralUntil', 'lastDonationDate', 'donationCount',
            'weightKg',
            'verifiedByStaffUid', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.eligibilityStatus in ['eligible', 'temporarily_deferred', 'permanently_deferred', 'pending_screening'];

        allow delete: if false; // Donors cannot be deleted; permanent regulatory traceability
      }

      // -----------------------------------------------------------------------
      // 8.2 Blood Donations Log
      // Collection draw records, volume, screening laboratory panel status.
      // -----------------------------------------------------------------------
      match /donations/{donationId} {
        allow read: if isAuthenticated() && isBloodBank();

        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == donationId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'donorId', 'donorName', 'bloodGroup', 'donationDate',
            'volumeMl', 'collectionStatus', 'screeningStatus', 'collectionStaffUid',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donorId', 'donorReferenceId', 'donorName', 'bloodGroup',
            'donationDate', 'volumeMl', 'collectionStatus', 'screeningStatus',
            'screeningStaffUid', 'screeningNotes', 'collectionStaffUid',
            'adverseEventNotes', 'createdAt', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/bloodBank/$(centerId)/donors/$(request.resource.data.donorId))
          && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
          && request.resource.data.collectionStatus in ['completed', 'partial', 'adverse_reaction', 'cancelled']
          && request.resource.data.screeningStatus in ['pending', 'tested_passed', 'tested_failed', 'quarantined']
          && request.resource.data.volumeMl is number
          && request.resource.data.volumeMl >= 50 && request.resource.data.volumeMl <= 700
          && request.resource.data.collectionStaffUid == request.auth.uid;

        allow update: if isAuthenticated() && isBloodBank()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'donorName', 'donorReferenceId', 'collectionStatus', 'screeningStatus',
            'screeningStaffUid', 'screeningNotes', 'adverseEventNotes', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.centerId == resource.data.centerId
          && request.resource.data.donorId == resource.data.donorId
          && request.resource.data.bloodGroup == resource.data.bloodGroup
          && request.resource.data.volumeMl == resource.data.volumeMl
          && request.resource.data.donationDate == resource.data.donationDate
          && request.resource.data.collectionStaffUid == resource.data.collectionStaffUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donorId', 'donorReferenceId', 'donorName', 'bloodGroup',
            'donationDate', 'volumeMl', 'collectionStatus', 'screeningStatus',
            'screeningStaffUid', 'screeningNotes', 'collectionStaffUid',
            'adverseEventNotes', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.collectionStatus in ['completed', 'partial', 'adverse_reaction', 'cancelled']
          && request.resource.data.screeningStatus in ['pending', 'tested_passed', 'tested_failed', 'quarantined'];

        allow delete: if false; // Permanent audit preservation
      }

      // -----------------------------------------------------------------------
      // 8.3 Blood Inventory Units
      // Individual component units with barcode, shelf life, and storage location.
      // -----------------------------------------------------------------------
      match /inventory/{unitId} {
        allow read: if isAuthenticated() && isBloodBank();

        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == unitId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'donationId', 'donorId', 'bloodGroup', 'componentType',
            'collectionDate', 'expiryDate', 'volumeMl', 'storageLocation', 'status',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donationId', 'donorId', 'bloodGroup', 'componentType',
            'collectionDate', 'expiryDate', 'volumeMl', 'storageLocation', 'status',
            'statusReason', 'reservedForRequestId', 'isExhibitionData', 'createdAt', 'updatedAt'
          ])
          && (
            (exists(/databases/$(database)/documents/bloodBank/$(centerId)/donations/$(request.resource.data.donationId)) &&
             isValidInventoryDonation(centerId, request.resource.data.donationId, request.resource.data.donorId, request.resource.data.bloodGroup)) ||
            (request.resource.data.isExhibitionData == true)
          )
          && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
          && request.resource.data.componentType in ['whole_blood', 'red_blood_cells', 'platelets', 'fresh_frozen_plasma', 'cryoprecipitate']
          && request.resource.data.status == 'available'
          && (!('reservedForRequestId' in request.resource.data) || request.resource.data.reservedForRequestId == null)
          && request.resource.data.volumeMl is number
          && request.resource.data.volumeMl > 0
          && request.resource.data.expiryDate >= request.resource.data.collectionDate;

        allow update: if isAuthenticated() && isBloodBank()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'expiryDate', 'volumeMl', 'storageLocation', 'status', 'statusReason',
            'reservedForRequestId', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.centerId == resource.data.centerId
          && request.resource.data.donationId == resource.data.donationId
          && request.resource.data.donorId == resource.data.donorId
          && request.resource.data.bloodGroup == resource.data.bloodGroup
          && request.resource.data.componentType == resource.data.componentType
          && request.resource.data.collectionDate == resource.data.collectionDate
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'donationId', 'donorId', 'bloodGroup', 'componentType',
            'collectionDate', 'expiryDate', 'volumeMl', 'storageLocation', 'status',
            'statusReason', 'reservedForRequestId', 'createdAt', 'updatedAt'
          ])
          && (
            request.resource.data.status != 'transfused' || (
              resource.data.status == 'reserved'
              && resource.data.reservedForRequestId != null
              && getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(resource.data.reservedForRequestId)).data.fulfilledUnitIds.hasAny([unitId])
            )
          )
          && (
            request.resource.data.status != 'reserved' || (
              request.resource.data.reservedForRequestId != null
            )
          )
          && (
            resource.data.status != 'reserved' ||
            request.resource.data.status in ['available', 'quarantine', 'expired', 'discarded'] ||
            request.resource.data.reservedForRequestId == resource.data.reservedForRequestId
          )
          && (
            !(resource.data.status in ['transfused', 'discarded', 'expired']) ||
            request.resource.data.reservedForRequestId == resource.data.reservedForRequestId
          )
          && isValidInventoryStateTransition(resource.data.status, request.resource.data.status);

        allow delete: if false; // Units transition to 'discarded' or 'transfused', never deleted
      }

      // -----------------------------------------------------------------------
      // 8.4 Blood Transfusion Requests
      // Hospital / Clinical facility supply orders.
      // -----------------------------------------------------------------------
      match /requests/{requestId} {
        allow read: if isAuthenticated() && isBloodBank();

        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == requestId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'requestingOrganization', 'bloodGroup', 'componentType',
            'quantityUnits', 'urgency', 'requiredByDate', 'status',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'requestingOrganization', 'departmentOrWard', 'patientIdentifier',
            'bloodGroup', 'componentType', 'quantityUnits', 'urgency', 'requiredByDate',
            'status', 'clinicalIndication', 'reviewerStaffUid', 'decisionNotes',
            'fulfilledUnitIds', 'allocatedUnitIds', 'createdAt', 'updatedAt'
          ])
          && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
          && request.resource.data.componentType in ['whole_blood', 'red_blood_cells', 'platelets', 'fresh_frozen_plasma', 'cryoprecipitate']
          && request.resource.data.urgency in ['routine', 'urgent', 'emergency_stat']
          && request.resource.data.status in ['submitted', 'under_review', 'approved', 'partially_fulfilled', 'fulfilled', 'rejected', 'cancelled']
          && request.resource.data.quantityUnits is int
          && request.resource.data.quantityUnits >= 1 && request.resource.data.quantityUnits <= 50;

        allow update: if isAuthenticated() && isBloodBank()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'departmentOrWard', 'urgency', 'requiredByDate', 'status',
            'clinicalIndication', 'reviewerStaffUid', 'decisionNotes',
            'fulfilledUnitIds', 'allocatedUnitIds', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.centerId == resource.data.centerId
          && request.resource.data.requestingOrganization == resource.data.requestingOrganization
          && request.resource.data.bloodGroup == resource.data.bloodGroup
          && request.resource.data.componentType == resource.data.componentType
          && request.resource.data.quantityUnits == resource.data.quantityUnits
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'requestingOrganization', 'departmentOrWard', 'patientIdentifier',
            'bloodGroup', 'componentType', 'quantityUnits', 'urgency', 'requiredByDate',
            'status', 'clinicalIndication', 'reviewerStaffUid', 'decisionNotes',
            'fulfilledUnitIds', 'allocatedUnitIds', 'createdAt', 'updatedAt'
          ])
          && isValidRequestStateTransition(resource.data.status, request.resource.data.status)
          && (
            !('fulfilledUnitIds' in resource.data) ||
            request.resource.data.fulfilledUnitIds.hasAll(resource.data.fulfilledUnitIds)
          )
          && (
            !('allocatedUnitIds' in resource.data) ||
            resource.data.allocatedUnitIds.size() == 0 ||
            request.resource.data.allocatedUnitIds.hasAll(resource.data.allocatedUnitIds) ||
            areAllocatedUnitsReleasedOrTransfused(centerId, resource.data.allocatedUnitIds)
          )
          && (
            !(request.resource.data.status in ['partially_fulfilled', 'fulfilled']) || (
              request.resource.data.fulfilledUnitIds is list &&
              request.resource.data.fulfilledUnitIds.size() > 0 &&
              (!('fulfilledUnitIds' in resource.data) || request.resource.data.fulfilledUnitIds.size() > resource.data.fulfilledUnitIds.size()) &&
              (request.resource.data.status != 'fulfilled' || request.resource.data.fulfilledUnitIds.size() >= resource.data.quantityUnits) &&
              (request.resource.data.status != 'partially_fulfilled' || request.resource.data.fulfilledUnitIds.size() < resource.data.quantityUnits) &&
              areUnitsTransfusedForRequest(centerId, request.resource.data.fulfilledUnitIds, requestId)
            )
          )
          && (
            request.resource.data.status in ['partially_fulfilled', 'fulfilled'] || (
              (!('fulfilledUnitIds' in resource.data) && (!('fulfilledUnitIds' in request.resource.data) || request.resource.data.fulfilledUnitIds.size() == 0)) ||
              (request.resource.data.fulfilledUnitIds == resource.data.fulfilledUnitIds)
            )
          )
          && (
            request.resource.data.status != 'cancelled' || (
              (!('allocatedUnitIds' in resource.data) || resource.data.allocatedUnitIds.size() == 0 || areUnitsAvailableOrDisposed(centerId, resource.data.allocatedUnitIds)) &&
              (!('allocatedUnitIds' in request.resource.data) || request.resource.data.allocatedUnitIds.size() == 0) &&
              (!('fulfilledUnitIds' in resource.data) ? (!('fulfilledUnitIds' in request.resource.data) || request.resource.data.fulfilledUnitIds.size() == 0) : request.resource.data.fulfilledUnitIds == resource.data.fulfilledUnitIds)
            )
          );

        allow delete: if false; // Retain history in 'cancelled' or 'rejected' state
      }

      // -----------------------------------------------------------------------
      // 8.5 Distribution / Dispatches
      // Issued blood units, verified cold-chain logs, recipient hospital tracking.
      // -----------------------------------------------------------------------
      match /issues/{issueId} {
        allow read: if isAuthenticated() && isBloodBank();

        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == issueId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'requestId', 'destinationOrganization', 'issuedUnitIds',
            'authorizedStaffUid', 'dispatchStatus', 'temperatureLogVerified',
            'createdAt', 'updatedAt'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'requestId', 'destinationOrganization', 'departmentOrWard',
            'issuedUnitIds', 'authorizedStaffUid', 'dispatchStatus', 'transportReference',
            'temperatureLogVerified', 'dispatchedAt', 'deliveredAt', 'notes',
            'createdAt', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(request.resource.data.requestId))
          && get(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(request.resource.data.requestId)).data.status in ['approved', 'partially_fulfilled']
          && request.resource.data.dispatchStatus in ['prepared', 'dispatched', 'in_transit', 'cancelled']
          && request.resource.data.authorizedStaffUid == request.auth.uid
          && request.resource.data.temperatureLogVerified == true
          && request.resource.data.issuedUnitIds is list
          && request.resource.data.issuedUnitIds.size() > 0
          && request.resource.data.issuedUnitIds.size() <= 4
          && request.resource.data.issuedUnitIds.toSet().size() == request.resource.data.issuedUnitIds.size()
          && (
            request.resource.data.dispatchStatus == 'cancelled' || (
              getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(request.resource.data.requestId)).data.allocatedUnitIds.hasAll(request.resource.data.issuedUnitIds) &&
              areUnitsReservedForRequest(centerId, request.resource.data.issuedUnitIds, request.resource.data.requestId)
            )
          );

        allow update: if isAuthenticated() && isBloodBank()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'departmentOrWard', 'dispatchStatus', 'transportReference',
            'dispatchedAt', 'deliveredAt', 'notes', 'updatedAt'
          ])
          && request.resource.data.id == resource.data.id
          && request.resource.data.centerId == resource.data.centerId
          && request.resource.data.requestId == resource.data.requestId
          && request.resource.data.destinationOrganization == resource.data.destinationOrganization
          && request.resource.data.issuedUnitIds == resource.data.issuedUnitIds
          && request.resource.data.authorizedStaffUid == resource.data.authorizedStaffUid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'requestId', 'destinationOrganization', 'departmentOrWard',
            'issuedUnitIds', 'authorizedStaffUid', 'dispatchStatus', 'transportReference',
            'temperatureLogVerified', 'dispatchedAt', 'deliveredAt', 'notes',
            'createdAt', 'updatedAt'
          ])
          && isValidIssueStateTransition(resource.data.dispatchStatus, request.resource.data.dispatchStatus)
          && (
            request.resource.data.dispatchStatus != 'delivered' || (
              resource.data.dispatchStatus in ['prepared', 'dispatched', 'in_transit'] &&
              request.resource.data.deliveredAt is string &&
              getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(resource.data.requestId)).data.status in ['partially_fulfilled', 'fulfilled'] &&
              getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(resource.data.requestId)).data.fulfilledUnitIds.hasAll(resource.data.issuedUnitIds) &&
              areUnitsTransfusedForRequest(centerId, resource.data.issuedUnitIds, resource.data.requestId)
            )
          )
          && (
            request.resource.data.dispatchStatus != 'cancelled' || (
              resource.data.dispatchStatus in ['prepared', 'dispatched', 'in_transit'] &&
              !getAfter(/databases/$(database)/documents/bloodBank/$(centerId)/requests/$(resource.data.requestId)).data.allocatedUnitIds.hasAny(resource.data.issuedUnitIds) &&
              areUnitsAvailableOrDisposed(centerId, resource.data.issuedUnitIds)
            )
          );

        allow delete: if false;
      }

      // -----------------------------------------------------------------------
      // 8.6 Immutable Operational Audit Logs
      // Append-only audit events. Modifications and deletions permanently denied.
      // -----------------------------------------------------------------------
      match /auditLogs/{auditId} {
        allow read: if isAuthenticated() && isBloodBank();

        allow create: if isAuthenticated() && isBloodBank()
          && request.resource.data.id == auditId
          && request.resource.data.centerId == centerId
          && request.resource.data.keys().hasAll([
            'id', 'centerId', 'actorUid', 'actorRole', 'action', 'entity',
            'entityId', 'timestamp'
          ])
          && request.resource.data.keys().hasOnly([
            'id', 'centerId', 'actorUid', 'actorEmail', 'actorRole', 'action',
            'entity', 'entityId', 'statusTransition', 'details', 'timestamp'
          ])
          && request.resource.data.actorUid == request.auth.uid
          && request.resource.data.actorRole == 'blood_bank'
          && request.resource.data.entity in ['donor', 'donation', 'inventory', 'request', 'distribution', 'system'];

        // Strict append-only: modifications and deletions permanently denied
        allow update: if false;
        allow delete: if false;
      }
    }

    // =========================================================================
    // 8.7 Network Blood Requests (Phase 4B Multi-Center Shared Network)
    // Namespace: /networkRequests/{requestId} (Root Level)
    // =========================================================================
    match /networkRequests/{requestId} {
      // Requesters can read their own; Blood Banks and Admins can read all active requests
      allow read: if isAuthenticated() && (
        resource.data.requesterUid == request.auth.uid ||
        isBloodBank() ||
        isAdmin()
      );

      // Patients and Doctors can create network requests bound to their authenticated UID (or staff for exhibition)
      allow create: if isAuthenticated() && (
        isPatient() || isDoctor() || (isBloodBank() && request.resource.data.isExhibitionData == true)
      )
        && request.resource.data.id == requestId
        && (request.resource.data.isExhibitionData == true || (
          request.resource.data.requesterUid == request.auth.uid &&
          request.resource.data.requesterRole == request.auth.token.role
        ))
        && request.resource.data.status == 'submitted'
        && request.resource.data.requestType in ['targeted', 'shortage_broadcast']
        && (
          request.resource.data.requestType != 'targeted' || (
            request.resource.data.targetCenterId is string &&
            request.resource.data.targetCenterId.size() > 0 &&
            exists(/databases/$(database)/documents/bloodBank/$(request.resource.data.targetCenterId))
          )
        )
        && request.resource.data.bloodGroup in ['A+', 'A-', 'B+', 'B-', 'AB+', 'AB-', 'O+', 'O-']
        && request.resource.data.componentType in ['whole_blood', 'red_blood_cells', 'platelets', 'fresh_frozen_plasma', 'cryoprecipitate']
        && request.resource.data.quantityUnits is int
        && request.resource.data.quantityUnits >= 1 && request.resource.data.quantityUnits <= 50
        && (!('acceptedCenterId' in request.resource.data) || request.resource.data.acceptedCenterId == null)
        && (!('assignedUnitIds' in request.resource.data) || request.resource.data.assignedUnitIds == null || request.resource.data.assignedUnitIds.size() == 0)
        && (!('fulfilledUnitIds' in request.resource.data) || request.resource.data.fulfilledUnitIds == null || request.resource.data.fulfilledUnitIds.size() == 0);

      // State transitions on network requests
      allow update: if isAuthenticated() && (
        // Requester Cancel: only when request is still 'submitted'
        (
          resource.data.requesterUid == request.auth.uid &&
          resource.data.status == 'submitted' &&
          request.resource.data.status == 'cancelled' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) ||
        // Requester Broadcast Conversion: when targeted request was rejected by center, requester can convert to broadcast
        (
          resource.data.requesterUid == request.auth.uid &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'submitted' &&
          request.resource.data.requestType == 'shortage_broadcast' &&
          (!('targetCenterId' in request.resource.data) || request.resource.data.targetCenterId == null) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'requestType', 'targetCenterId', 'updatedAt'])
        ) ||
        // Blood Bank Claim & Reservation: moves from 'submitted' to 'accepted' or 'reserved'
        (
          isBloodBank() &&
          resource.data.status == 'submitted' &&
          request.resource.data.status in ['accepted', 'reserved'] &&
          request.resource.data.acceptedCenterId is string &&
          request.resource.data.acceptedCenterId.size() > 0 &&
          request.resource.data.authorizedStaffUid == request.auth.uid &&
          (
            request.resource.data.status != 'reserved' || (
              request.resource.data.assignedUnitIds is list &&
              request.resource.data.assignedUnitIds.size() >= 1 &&
              request.resource.data.assignedUnitIds.size() <= resource.data.quantityUnits
            )
          ) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'acceptedCenterId', 'assignedUnitIds', 'authorizedStaffUid', 'updatedAt'
          ])
        ) ||
        // Blood Bank Target Rejection: target blood bank can reject a targeted request
        (
          isBloodBank() &&
          resource.data.status == 'submitted' &&
          resource.data.requestType == 'targeted' &&
          request.resource.data.status == 'rejected' &&
          request.resource.data.authorizedStaffUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'rejectionReason', 'authorizedStaffUid', 'updatedAt'
          ])
        ) ||
        // Blood Bank Dispatch / Fulfillment / Cancellation lifecycle
        (
          isBloodBank() &&
          resource.data.status in ['accepted', 'reserved', 'dispatched'] &&
          request.resource.data.status in ['dispatched', 'fulfilled', 'cancelled'] &&
          request.resource.data.acceptedCenterId == resource.data.acceptedCenterId &&
          request.resource.data.authorizedStaffUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assignedUnitIds', 'fulfilledUnitIds', 'authorizedStaffUid', 'updatedAt'
          ])
        )
      );

      allow delete: if false; // Permanent audit preservation
    }

}
}
