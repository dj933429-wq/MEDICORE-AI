{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        "$connectionKey": {
          ".write": "auth != null && auth.uid === $uid && !newData.exists()"
        }
      }
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": false
      }
    },
    "reservations": {
      ".read": false,
      ".write": false
    }
  }
}

