{
  "rules": {
    "presence": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        "$connectionKey": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['connectedAt']) || newData.val() == null"
        }
      }
    },
    "activity": {
      "$uid": {
        ".read": "auth != null && (auth.uid === $uid || auth.token.role === 'admin')",
        ".write": false
      }
    }
  }
}
