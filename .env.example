# ==========================================
# MEDICORE-AI Environment Configuration Template
# ==========================================
# Copy this file to .env.local and populate with your own project credentials.
# NEVER commit .env or .env.local to version control.

# Firebase Web Client Configuration (Required for Auth & Firestore)
# Obtain these values from Firebase Console -> Project Settings -> General -> Your apps -> SDK setup/configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_web_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id

# Google Gemini API Configuration (Server-Side Only)
# Obtain this key from Google AI Studio (https://aistudio.google.com/)
# IMPORTANT: Keep this server-side only. Do NOT prefix with NEXT_PUBLIC_ or forward via next.config.js.
GEMINI_API_KEY=your_server_side_gemini_api_key

